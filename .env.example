# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitnessapp?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=fitness_token

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="PulseFit <noreply@pulsefit.test>"

# ── Social login (optional — fill to activate each provider) ────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Seed admin (used by db:seed) ────────────────────────────────────────────
ADMIN_EMAIL=admin@pulsefit.test
ADMIN_PASSWORD=Admin123!
